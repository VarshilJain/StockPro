# =============================================================================
# StockPro Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# Application Environment: 'development', 'staging', or 'production'
STOCKPRO_ENV=

# JWT Authentication
# In production, this must be a cryptographically random secret of at least 32 characters.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_HOURS=

# Google OAuth (optional, for Sign-in with Google)
GOOGLE_CLIENT_ID=


# Database Configuration
# In production, use a dedicated least-privilege user (never root/root).
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Frontend & CORS Settings
# Comma-separated list of allowed origins (e.g., https://app.example.com,https://dashboard.example.com)
STOCKPRO_FRONTEND_ORIGINS=

# Cookie Security (set to 'true' in production behind HTTPS)
COOKIE_SECURE=

# Proxy Settings (set to 'true' only if deployed behind a trusted reverse proxy)
BEHIND_TRUSTED_PROXY=

# Redis (optional, for distributed rate limiting)
REDIS_URL=

# OpenRouter / AI Settings (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
FUNDAMENTALS_CACHE_TTL_HOURS=
